# SUCHER-1000 — Optionale API-Keys (Env-Vorlage)
# =================================================
# ALLE Quellen funktionieren OHNE Keys (Key-freie Basis: ddgs, Bing,
# Wikipedia DE+EN, Mojeek). Diese Keys schalten ZUSÄTZLICHE Quellen frei.
#
# Nutzung: Datei kopieren → Keys eintragen:
#   cp .env.example ~/.hermes/.env   (Hermes-Kontext)
#   cp .env.example .env             (Standalone — wird automatisch geladen?)
#
# Keys sind OPTIONAL — fehlt einer, wird die Quelle übersprungen (Meldung,
# kein Fehler).

# Tavily (karte-frei, 1000 Suchen/Monat) — beste Zusatz-Webquelle
# https://tavily.com
TAVILY_API_KEY=

# Exa (semantische Websuche)
# https://exa.ai
EXA_API_KEY=

# SerpApi (Google-Rankings)
# https://serpapi.com
SERPAPI_API_KEY=

# DataImpulse-Proxy (optionaler Block-Umgehungs-Proxy, nur bei Captcha/403)
# https://dataimpulse.com
PROXY_LOGIN=
PROXY_PASSWORD=
DATAIMPULSE_URL=

# Interne Pfade (nur für Tests/Portabilität — Defaults sind ok)
# SUCHER_DB=data/sucher.db          # SQLite-Archiv
# SUCHER_CACHE_DB=data/sucher_cache.db  # TTL-Such-Cache
# SUCHER_HEALTH_FILE=data/health.json   # Health-Registry
