# SUCHER-1000 — Optionale API-Keys (Env-Vorlage)
# =================================================
# ALLE Quellen funktionieren OHNE Keys (Key-freie Basis: ddgs, Bing,
# Wikipedia DE+EN, Mojeek). Diese Keys schalten ZUSÄTZLICHE Quellen frei.
#
# Nutzung: Datei kopieren → Keys eintragen:
#   cp .env.example ~/.hermes/.env   (Keys werden von dort automatisch gelesen)
# Achtung: Keys werden aus der Umgebung ODER ~/.hermes/.env gelesen — eine
# .env-Datei IM PROJEKTORDNER wird NICHT automatisch geladen.
#
# Keys sind OPTIONAL — fehlt einer, wird die Quelle übersprungen (Meldung,
# kein Fehler).

# Tavily (karte-frei, 1000 Suchen/Monat) — beste Zusatz-Webquelle
# https://tavily.com
TAVILY_API_KEY=

# Exa (semantische Websuche)
# https://exa.ai
EXA_API_KEY=

# SerpApi (Google-Rankings)
# https://serpapi.com
SERPAPI_API_KEY=

# DataImpulse-Proxy (optionaler Block-Umgehungs-Proxy, nur bei Captcha/403)
# https://dataimpulse.com
PROXY_LOGIN=
PROXY_PASSWORD=
DATAIMPULSE_URL=

# Reddit (offizielle OAuth-Data-API — kostenlose App, 100 Queries/min)
# App registrieren: https://www.reddit.com/prefs/apps (script, karte-frei)
# Ohne Key wird Reddit übersprungen (.json-Scraping blockt seit 2026).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Google Knowledge Graph (semantische Entitäten — 100.000 Calls/Tag gratis)
# Key: https://console.cloud.google.com → APIs & Services (kostenlos)
GOOGLE_KG_API_KEY=

# Google Books API (anonym 429 geteiltes Tagesquota → nur mit eigenem Key)
# Key: https://console.cloud.google.com → APIs & Services (kostenlos)
GOOGLE_BOOKS_API_KEY=

# ZenRows (Google-SERP-Scraper — 5.000 Credits/Monat gratis, karte-frei)
# Key: https://app.zenrows.com/register
ZENROWS_API_KEY=

# SearchAPI.io (50+ Engines in einem Key — 100 Requests gratis)
# Key: https://www.searchapi.io/dashboard
SEARCHAPI_KEY=

# Serper (Google-SERP — 2.500 Suchen gratis, dann $1/1k)
# Key: https://serper.dev/api-key
SERPER_API_KEY=

# You.com (100 Suchen/Tag dauerhaft gratis)
# Key: https://you.com/platform
YOUCOM_API_KEY=

# Firecrawl (Tavily-Ersatz + Scrape — 1.000 Credits/Monat gratis ≈ 500 Suchen)
# Key: https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# Interne Pfade (nur für Tests/Portabilität — Defaults sind ok)
# SUCHER_DB=data/sucher.db          # SQLite-Archiv
# SUCHER_CACHE_DB=data/sucher_cache.db  # TTL-Such-Cache
# SUCHER_HEALTH_FILE=data/health.json   # Health-Registry
